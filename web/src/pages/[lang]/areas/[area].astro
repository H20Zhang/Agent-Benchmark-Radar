---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PageHero from '../../../components/PageHero.astro';
import BenchmarkCard from '../../../components/BenchmarkCard.astro';
import { AREAS, LOCALES, copyFor } from '../../../lib/i18n.mjs';
import { loadRegistry } from '../../../lib/registry.mjs';
import { loadChineseSummaries } from '../../../lib/readme-localization.mjs';
import { loadAllResultSets } from '../../../lib/results.mjs';
import { loadResearchModel, localize } from '../../../lib/research-model.mjs';
import { localePath, sitePath, absoluteUrl } from '../../../lib/site.mjs';
export function getStaticPaths(){return LOCALES.flatMap(lang=>AREAS.map(area=>({params:{lang,area},props:{lang,area}})));}
interface Props{lang:'zh'|'en';area:'agent-memory'|'rag'|'data-agent';}
const {lang,area}=Astro.props,zh=lang==='zh',copy=copyFor(lang);
const items=loadRegistry().filter(item=>item.area===area),summaries=loadChineseSummaries(),results=loadAllResultSets(),research=loadResearchModel();
const genealogy=research.genealogy.areas.find((entry:any)=>entry.id===area);
const byId=new Map(loadRegistry().map(item=>[item.id,item]));
const canonicalPath=localePath(lang,`areas/${area}/`),alternatePath=localePath(zh?'en':'zh',`areas/${area}/`);
const title=`${copy.areas[area].label} | Agent Benchmark Radar`;
const description=zh?`${items.length} 个基准，先浏览测量对象与公开记录，再查看领域解读。`:`${items.length} benchmarks. Browse measurement targets and public records before exploring editorial analysis.`;
const jsonLd={'@context':'https://schema.org','@type':'CollectionPage',name:title,url:absoluteUrl(canonicalPath)};
---
<BaseLayout {lang} {title} {description} {canonicalPath} zhPath={zh?canonicalPath:alternatePath} enPath={zh?alternatePath:canonicalPath} {jsonLd} bodyClass="radar-page area-page">
  <Header {lang} {alternatePath}/><main id="main-content">
    <PageHero title={copy.areas[area].label} {description}><div class="action-links"><a href={sitePath(localePath(lang,`timeline/?area=${area}&window=all`))}>{zh?'按月份浏览':'Browse by month'} →</a><a href={sitePath(localePath(lang,`benchmarks/?area=${area}`))}>{zh?'筛选本领域':'Filter this area'} →</a><a href={sitePath(localePath(lang,`evaluate/?area=${area}`))}>{zh?'选择评测组合':'Choose a suite'} →</a></div></PageHero>
    <section class="shell page-section area-registry"><h2>{zh?'完整基准目录':'Complete benchmark library'}</h2><div class="benchmark-grid">{items.map(item=><BenchmarkCard {lang} {item} summary={zh?summaries.get(item.id):item.summary} resultSet={results.get(item.id)}/>)}</div></section>
    <section class="shell page-section"><h2>{zh?'领域解读':'Area interpretation'}</h2><p class="content-note">{zh?'以下谱系和研究机会是编辑判断，不参与上方的时间排序。':'The following genealogy and opportunities are editorial judgments; they do not determine the chronology above.'}</p>
      {genealogy&&<details class="editorial-section"><summary>{zh?'测量能力的演进脉络':'Measurement genealogy'}</summary><p>{localize(genealogy.thesis,lang)}</p><div class="genealogy-rail">{genealogy.stages.map((stage:any)=><article><h3>{localize(stage.label,lang)}</h3>{stage.benchmarks.map((id:string)=><a href={sitePath(localePath(lang,`benchmarks/${id}/`))}>{byId.get(id)?.name}</a>)}</article>)}</div></details>}
      <div class="related-recipes">{research.opportunities.filter((entry:any)=>entry.area===area).map((entry:any)=><a href={sitePath(localePath(lang,`opportunities/${entry.id}/`))}><strong>{localize(entry.title,lang)}</strong><span>{zh?'待验证研究假设':'Research hypothesis'} →</span></a>)}</div>
    </section>
  </main><SiteFooter {lang}/>
</BaseLayout>
