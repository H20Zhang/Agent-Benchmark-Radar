---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import Explorer from "../../../components/Explorer.astro";

import { copyFor, LOCALES } from "../../../lib/i18n.mjs";
import { loadChineseSummaries } from "../../../lib/readme-localization.mjs";
import { loadRegistry } from "../../../lib/registry.mjs";
import { getStableFacets, loadResearchModel } from "../../../lib/research-model.mjs";
import { loadAllResultSets } from "../../../lib/results.mjs";
import { absoluteUrl, localePath } from "../../../lib/site.mjs";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: "zh" | "en"; }
const { lang } = Astro.props;
const copy = copyFor(lang);
const items = [...loadRegistry()];
const summaries = loadChineseSummaries();
loadResearchModel();
const stableFacets = getStableFacets(items);
const resultSets = loadAllResultSets();
const canonicalPath = localePath(lang, "benchmarks/");
const alternatePath = localePath(lang === "zh" ? "en" : "zh", "benchmarks/");
const title = lang === "zh" ? "Agent 基准筛选｜按领域、能力与成绩找评测" : "Agent Benchmark Explorer | Filter by Area, Capability, and Results";
const description = lang === "zh"
  ? `从 ${items.length} 个 Agent 基准中按领域、时间、能力、环境、结果覆盖与参考空间快速筛选，并直接打开详情页。`
  : "Filter the benchmark registry by area, time, capability, environment, result coverage, and reference headroom, then open any benchmark detail page.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: absoluteUrl(canonicalPath),
  inLanguage: copy.langTag,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: items.length,
    itemListElement: items.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      url: absoluteUrl(localePath(lang, `benchmarks/${item.id}/`)),
    })),
  },
};
---

<BaseLayout {lang} {title} {description} {canonicalPath} zhPath={lang === "zh" ? canonicalPath : alternatePath} enPath={lang === "en" ? canonicalPath : alternatePath} {jsonLd} bodyClass="radar-page explorer-v2-page core-tool-page">
  <Header {lang} alternatePath={alternatePath} />
  <main id="main-content">
    <section class="tool-hero core-tool-hero explorer-hero shell">
      <div><p class="eyebrow">{lang === "zh" ? "基准筛选" : "Benchmark explorer"}</p><h1>{lang === "zh" ? "快速筛到真正适合你研究问题的基准" : "Find the benchmark that actually fits your research question"}</h1></div>
      <p>{description}</p>
      <dl><div><dt>{lang === "zh" ? "基准总数" : "Registry"}</dt><dd>{items.length}</dd></div><div><dt>{lang === "zh" ? "已有成绩" : "Result sets"}</dt><dd>{resultSets.size}</dd></div><div><dt>{lang === "zh" ? "筛选维度" : "Stable dimensions"}</dt><dd>{stableFacets.length}</dd></div></dl>
    </section>
    <Explorer {lang} {items} {summaries} {stableFacets} {resultSets} />
  </main>
  <SiteFooter {lang} />
</BaseLayout>