---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PageHero from '../../../components/PageHero.astro';
import Timeline from '../../../components/Timeline.astro';
import { LOCALES } from '../../../lib/i18n.mjs';
import { localePath } from '../../../lib/site.mjs';
export function getStaticPaths(){return LOCALES.map(lang=>({params:{lang},props:{lang}}));}
interface Props{lang:'zh'|'en';}
const {lang}=Astro.props;
const canonicalPath=localePath(lang,'timeline/'),alternatePath=localePath(lang==='zh'?'en':'zh','timeline/');
const title=lang==='zh'?'Benchmark 公开时间轴 | Agent Benchmark Radar':'Benchmark release timeline | Agent Benchmark Radar';
const description=lang==='zh'?'按日期浏览，保留来源与时间精度；研究判断不参与收录排序。':'Browse dated records with sources and original precision. Editorial judgments do not determine chronological order.';
---
<BaseLayout {lang} {title} {description} {canonicalPath} zhPath={lang==='zh'?canonicalPath:alternatePath} enPath={lang==='en'?canonicalPath:alternatePath} bodyClass="radar-page timeline-page">
  <Header {lang} {alternatePath}/><main id="main-content"><PageHero title={lang==='zh'?'Benchmark 公开时间轴':'Benchmark release timeline'} {description}/><Timeline {lang}/></main><SiteFooter {lang}/>
</BaseLayout>
