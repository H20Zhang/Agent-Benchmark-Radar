---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { LOCALES } from "../../lib/i18n.mjs";
import { localePath, sitePath } from "../../lib/site.mjs";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: "zh" | "en"; }

const { lang } = Astro.props;
const canonicalPath = localePath(lang);
const alternatePath = localePath(lang === "zh" ? "en" : "zh");
const title = lang === "zh"
  ? "Agent Benchmark Radar｜网站待完善"
  : "Agent Benchmark Radar | Website under improvement";
const description = lang === "zh"
  ? "Agent Benchmark Radar 网站正在重新整理，当前请以 GitHub README 为准。"
  : "The Agent Benchmark Radar website is being reorganized. Please use the GitHub README for now.";
const readmeUrl = lang === "zh"
  ? "https://github.com/H20Zhang/Agent-Benchmark-Radar"
  : "https://github.com/H20Zhang/Agent-Benchmark-Radar/blob/main/README.en.md";
---

<BaseLayout
  {lang}
  {title}
  {description}
  {canonicalPath}
  zhPath={lang === "zh" ? canonicalPath : alternatePath}
  enPath={lang === "en" ? canonicalPath : alternatePath}
  robots="noindex,nofollow"
  bodyClass="wip-page"
>
  <main id="main-content" class="wip-shell">
    <p class="wip-brand">Agent Benchmark Radar</p>
    <h1>{lang === "zh" ? "网站待完善" : "Website under improvement"}</h1>
    <p class="wip-summary">
      {lang === "zh"
        ? "聚合 Agent Memory、RAG / Agentic Retrieval 与 Data Agents 的 Benchmark、当前成绩与研究空间。"
        : "Tracking benchmarks, current results, and research headroom across Agent Memory, RAG / Agentic Retrieval, and Data Agents."}
    </p>
    <p class="wip-status">
      {lang === "zh"
        ? "当前版本请以 GitHub README 为准。网站的内容结构正在重新整理，成熟后再开放完整入口。"
        : "Please use the GitHub README as the source of truth for now. The website content structure is being reorganized before the full experience returns."}
    </p>
    <div class="wip-links">
      <a class="wip-primary" href={readmeUrl}>{lang === "zh" ? "查看 GitHub README →" : "Read the GitHub README →"}</a>
      <a class="wip-language" href={sitePath(alternatePath)}>{lang === "zh" ? "English" : "中文"}</a>
    </div>
  </main>

  <style>
    :global(.wip-page) {
      background: #fff;
      color: #171717;
    }

    :global(.wip-page .ambient-grid) {
      display: none;
    }

    .wip-shell {
      width: min(720px, calc(100% - 40px));
      margin: 0 auto;
      padding: clamp(96px, 16vh, 180px) 0 80px;
    }

    .wip-brand {
      margin: 0 0 48px;
      font: 600 14px/1.4 ui-sans-serif, system-ui, sans-serif;
      letter-spacing: 0.02em;
    }

    h1 {
      margin: 0;
      font: 650 clamp(40px, 7vw, 68px)/1.05 ui-sans-serif, system-ui, sans-serif;
      letter-spacing: -0.045em;
    }

    .wip-summary {
      max-width: 650px;
      margin: 30px 0 0;
      font: 500 clamp(19px, 2.5vw, 24px)/1.55 ui-sans-serif, system-ui, sans-serif;
    }

    .wip-status {
      max-width: 620px;
      margin: 20px 0 0;
      color: #666;
      font: 400 16px/1.7 ui-sans-serif, system-ui, sans-serif;
    }

    .wip-links {
      display: flex;
      align-items: center;
      gap: 24px;
      margin-top: 40px;
      font: 600 15px/1.4 ui-sans-serif, system-ui, sans-serif;
    }

    .wip-links a {
      color: inherit;
      text-decoration: none;
    }

    .wip-primary {
      padding-bottom: 3px;
      border-bottom: 1px solid currentColor;
    }

    .wip-language {
      color: #777 !important;
      font-weight: 500;
    }

    @media (max-width: 560px) {
      .wip-shell {
        width: min(100% - 32px, 720px);
        padding-top: 72px;
      }

      .wip-brand {
        margin-bottom: 40px;
      }
    }
  </style>
</BaseLayout>
