---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageHero from '../../components/PageHero.astro';
import Timeline from '../../components/Timeline.astro';
import { LOCALES, AREAS, copyFor } from '../../lib/i18n.mjs';
import { loadRegistry } from '../../lib/registry.mjs';
import { localePath, sitePath } from '../../lib/site.mjs';
export function getStaticPaths() { return LOCALES.map(lang => ({ params:{lang}, props:{lang} })); }
interface Props { lang:'zh'|'en'; }
const {lang}=Astro.props;
const copy=copyFor(lang), registry=loadRegistry();
const canonicalPath=localePath(lang),alternatePath=localePath(lang==='zh'?'en':'zh');
const title=lang==='zh'?'Agent Benchmark Radar｜时间轴与基准目录':'Agent Benchmark Radar | Timeline and benchmark library';
const description=lang==='zh'?`按公开记录浏览 ${registry.length} 个基准，筛选领域与月份，直达论文、代码和评测解读。`:`Browse ${registry.length} benchmarks by public record, area, and month, with direct access to papers, code, and evaluation notes.`;
---
<BaseLayout {lang} {title} {description} {canonicalPath} zhPath={lang==='zh'?canonicalPath:alternatePath} enPath={lang==='en'?canonicalPath:alternatePath} robots="index,follow" bodyClass="radar-page home-page">
  <Header {lang} {alternatePath}/>
  <main id="main-content">
    <PageHero title={lang==='zh'?'Agent Benchmark 时间轴':'Agent Benchmark Timeline'} {description} />
    <Timeline {lang}/>
    <section id="field-map" class="shell page-section">
      <h2>{lang==='zh'?'按领域继续阅读':'Explore a research area'}</h2>
      <div class="area-links">{AREAS.map(area=><a href={sitePath(localePath(lang,`areas/${area}/`))}><strong>{copy.areas[area].label}</strong><span>{registry.filter(item=>item.area===area).length} {lang==='zh'?'个基准':'benchmarks'} →</span></a>)}</div>
      <p class="content-note">{lang==='zh'?'领域地图、评测组合和研究机会是编辑解读，与公开日期和来源记录分开维护。':'Area maps, suite suggestions, and opportunities are editorial interpretations, maintained separately from dated source records.'}</p>
    </section>
    <section id="results" class="shell page-section"><h2>{lang==='zh'?'从基准到实验设计':'From benchmarks to experiments'}</h2><div class="action-links"><a href={sitePath(localePath(lang,'evaluate/'))}>{lang==='zh'?'组合评测':'Build a suite'} →</a><a href={sitePath(localePath(lang,'compare/'))}>{lang==='zh'?'对照测量设计':'Compare designs'} →</a><a href={sitePath(localePath(lang,'methodology/'))}>{lang==='zh'?'核对证据规则':'Review evidence rules'} →</a></div></section>
  </main><SiteFooter {lang}/>
</BaseLayout>
