---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { LOCALES } from "../../lib/i18n.mjs";
import { loadChineseSummaries } from "../../lib/readme-localization.mjs";
import { loadRegistry } from "../../lib/registry.mjs";
import { loadResearchModel, localize } from "../../lib/research-model.mjs";
import { localePath, sitePath } from "../../lib/site.mjs";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: "zh" | "en"; }
const { lang } = Astro.props;
const canonicalPath = localePath(lang);
const alternatePath = localePath(lang === "zh" ? "en" : "zh");
const registry = [...loadRegistry()];
const summaries = loadChineseSummaries();
const research = loadResearchModel();
const recent = registry.slice(0, 12);
const latestVerified = registry.map((item) => item.last_verified || "").filter(Boolean).sort().at(-1) || "—";
const counts = {
  "agent-memory": registry.filter((item) => item.area === "agent-memory").length,
  rag: registry.filter((item) => item.area === "rag").length,
  "data-agent": registry.filter((item) => item.area === "data-agent").length,
};
const areas = [
  {
    id: "agent-memory",
    name: lang === "zh" ? "Agent Memory" : "Agent Memory",
    thesis: lang === "zh" ? "从召回走向状态更新、经验迁移、多模态与完整 memory lifecycle。" : "From recall to state updates, experience transfer, multimodality, and the full memory lifecycle.",
  },
  {
    id: "rag",
    name: lang === "zh" ? "RAG / Agentic Retrieval" : "RAG / Agentic Retrieval",
    thesis: lang === "zh" ? "从静态相关性走向长程搜索、动态语料、轨迹诊断与可验证研究交付。" : "From static relevance to long-horizon search, dynamic corpora, trace diagnosis, and verifiable research deliverables.",
  },
  {
    id: "data-agent",
    name: lang === "zh" ? "Data Agents" : "Data Agents",
    thesis: lang === "zh" ? "从 SQL / code 正确走向数据发现、业务语义、完整工作流与可执行交付。" : "From SQL and code correctness to discovery, business semantics, complete workflows, and executable deliverables.",
  },
];
const title = lang === "zh" ? "Agent Benchmark Radar｜Agent 评测研究地图" : "Agent Benchmark Radar | Research Map for Agent Evaluation";
const description = lang === "zh"
  ? `持续维护 ${registry.length} 个 Agent Memory、Agentic Retrieval 与 Data Agent Benchmark：最新发布、评测协议、结果边界、研究缺口与详情页。`
  : `A maintained research map of ${registry.length} Agent Memory, Agentic Retrieval, and Data Agent benchmarks: releases, protocols, score boundaries, gaps, and deep reads.`;
---

<BaseLayout
  {lang}
  {title}
  {description}
  {canonicalPath}
  zhPath={lang === "zh" ? canonicalPath : alternatePath}
  enPath={lang === "en" ? canonicalPath : alternatePath}
  robots="index,follow"
  bodyClass="radar-page content-home"
>
  <Header {lang} alternatePath={alternatePath} />
  <main id="main-content" class="content-home__main">
    <section class="content-home__intro shell">
      <p class="content-home__kicker">Agent Benchmark Radar</p>
      <h1>{lang === "zh" ? "先看评测发生了什么，再决定用哪个 Benchmark" : "See what evaluation changed before choosing a benchmark"}</h1>
      <p class="content-home__lede">{description}</p>
      <div class="content-home__status" aria-label={lang === "zh" ? "内容状态" : "Content status"}>
        <span><strong>{registry.length}</strong> {lang === "zh" ? "个 Benchmark" : "benchmarks"}</span>
        <span><strong>{latestVerified}</strong> {lang === "zh" ? "最近核验" : "latest verification"}</span>
        <a href={sitePath(localePath(lang, "benchmarks/"))}>{lang === "zh" ? "搜索完整 Library →" : "Search the full library →"}</a>
      </div>
    </section>

    <section class="content-home__section shell" aria-labelledby="recent-heading">
      <div class="content-home__section-head">
        <div>
          <p class="content-home__label">{lang === "zh" ? "最新发布" : "Latest releases"}</p>
          <h2 id="recent-heading">{lang === "zh" ? "最近进入评测视野的 Benchmark" : "Benchmarks most recently entering the evaluation landscape"}</h2>
        </div>
        <a href={sitePath(localePath(lang, "frontier/"))}>{lang === "zh" ? "看 Frontier 判断 →" : "Read frontier analysis →"}</a>
      </div>
      <div class="content-home__table-wrap">
        <table class="content-home__table">
          <thead><tr>
            <th>{lang === "zh" ? "时间" : "Release"}</th>
            <th>Benchmark</th>
            <th>{lang === "zh" ? "方向" : "Area"}</th>
            <th>{lang === "zh" ? "它测什么" : "What it measures"}</th>
          </tr></thead>
          <tbody>
            {recent.map((item) => (
              <tr>
                <td><time>{item.released}</time></td>
                <td><a href={sitePath(localePath(lang, `benchmarks/${item.id}/`))}>{item.name}</a></td>
                <td>{item.area === "agent-memory" ? "Memory" : item.area === "rag" ? "Retrieval" : "Data"}</td>
                <td>{lang === "zh" ? (summaries.get(item.id) || item.summary) : item.summary}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="content-home__section shell" aria-labelledby="signals-heading">
      <div class="content-home__section-head">
        <div>
          <p class="content-home__label">{lang === "zh" ? "研究信号" : "Research signals"}</p>
          <h2 id="signals-heading">{lang === "zh" ? "哪些变化会真的改变实验设计" : "Changes that actually alter experimental design"}</h2>
        </div>
      </div>
      <div class="content-home__signals">
        {research.frontierShifts.slice(0, 6).map((shift) => (
          <article>
            <p>{shift.area === "agent-memory" ? "Memory" : shift.area === "rag" ? "Retrieval" : "Data"}</p>
            <h3>{localize(shift.title, lang)}</h3>
            <div><strong>{lang === "zh" ? "变化：" : "Delta: "}</strong>{localize(shift.delta, lang)}</div>
            <div><strong>{lang === "zh" ? "为什么重要：" : "Why it matters: "}</strong>{localize(shift.consequence, lang)}</div>
            <p class="content-home__bench-links">
              {shift.benchmarks.map((id) => {
                const item = registry.find((entry) => entry.id === id);
                return item ? <a href={sitePath(localePath(lang, `benchmarks/${id}/`))}>{item.name}</a> : null;
              })}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="content-home__section shell" aria-labelledby="areas-heading">
      <div class="content-home__section-head"><div><p class="content-home__label">{lang === "zh" ? "三条主线" : "Three research lines"}</p><h2 id="areas-heading">{lang === "zh" ? "按研究问题进入，而不是按页面功能进入" : "Enter by research question, not by product feature"}</h2></div></div>
      <div class="content-home__areas">
        {areas.map((area) => (
          <article>
            <div><span>{counts[area.id]}</span> {lang === "zh" ? "个基准" : "benchmarks"}</div>
            <h3>{area.name}</h3>
            <p>{area.thesis}</p>
            <p><a href={sitePath(localePath(lang, `areas/${area.id}/`))}>{lang === "zh" ? "看能力地图与完整列表 →" : "Capability map and full list →"}</a></p>
          </article>
        ))}
      </div>
    </section>

    <section class="content-home__section shell content-home__methods" aria-labelledby="method-heading">
      <p class="content-home__label">{lang === "zh" ? "读分数之前" : "Before reading scores"}</p>
      <h2 id="method-heading">{lang === "zh" ? "不同 protocol cell 的分数，不直接比较" : "Scores from different protocol cells are not directly comparable"}</h2>
      <p>{lang === "zh"
        ? "Radar 把模型版本、harness、工具接口、预算、停止 / 重试规则、环境与 evaluator 当成一等元数据。论文报告过的最好结果不自动等于当前 SOTA，距满分也不等于可实现 research headroom。"
        : "Radar treats model version, harness, tools, budget, stopping/retry rules, environment, and evaluator as first-class metadata. A paper's best reported result is not automatically current SOTA, and distance to 100% is not realizable research headroom."}</p>
      <div class="content-home__method-links">
        <a href={sitePath(localePath(lang, "evaluate/"))}>{lang === "zh" ? "按 claim 组评测 →" : "Build an evaluation suite →"}</a>
        <a href={sitePath(localePath(lang, "methodology/"))}>{lang === "zh" ? "方法与证据纪律 →" : "Methodology and evidence discipline →"}</a>
        <a href={sitePath(localePath(lang, "opportunities/"))}>{lang === "zh" ? "真正还没测到什么 →" : "What remains unmeasured →"}</a>
      </div>
    </section>
  </main>
  <SiteFooter {lang} />

  <style>
    :global(.content-home) { background: #fff; color: #171717; }
    :global(.content-home .ambient-grid) { display: none; }
    .content-home__main { padding-bottom: 72px; }
    .shell { width: min(1120px, calc(100% - 40px)); margin-inline: auto; }
    .content-home__intro { padding: 72px 0 44px; border-bottom: 1px solid #e7e7e7; }
    .content-home__kicker, .content-home__label { margin: 0 0 12px; font: 650 12px/1.4 ui-sans-serif, system-ui, sans-serif; letter-spacing: .08em; text-transform: uppercase; color: #686868; }
    h1 { max-width: 900px; margin: 0; font: 680 clamp(36px, 5vw, 60px)/1.06 ui-sans-serif, system-ui, sans-serif; letter-spacing: -.04em; }
    .content-home__lede { max-width: 860px; margin: 24px 0 0; font: 400 18px/1.65 ui-sans-serif, system-ui, sans-serif; color: #444; }
    .content-home__status { display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; margin-top: 30px; font: 14px/1.5 ui-sans-serif, system-ui, sans-serif; color: #555; }
    .content-home__status a, .content-home__section a, .content-home__methods a { color: #111; text-decoration-thickness: 1px; text-underline-offset: 3px; }
    .content-home__section { padding: 52px 0; border-bottom: 1px solid #e7e7e7; }
    .content-home__section-head { display: flex; justify-content: space-between; align-items: end; gap: 28px; margin-bottom: 24px; }
    h2 { max-width: 820px; margin: 0; font: 650 clamp(25px, 3.2vw, 36px)/1.18 ui-sans-serif, system-ui, sans-serif; letter-spacing: -.025em; }
    .content-home__table-wrap { overflow-x: auto; }
    .content-home__table { width: 100%; border-collapse: collapse; font: 14px/1.55 ui-sans-serif, system-ui, sans-serif; }
    .content-home__table th { text-align: left; padding: 10px 12px 10px 0; border-bottom: 1px solid #bbb; color: #555; font-size: 12px; }
    .content-home__table td { vertical-align: top; padding: 15px 18px 15px 0; border-bottom: 1px solid #eee; }
    .content-home__table td:first-child { white-space: nowrap; color: #666; }
    .content-home__table td:nth-child(2) { min-width: 180px; font-weight: 650; }
    .content-home__table td:nth-child(3) { min-width: 90px; color: #666; }
    .content-home__signals { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid #ddd; }
    .content-home__signals article { padding: 24px 28px 24px 0; border-bottom: 1px solid #ddd; }
    .content-home__signals article:nth-child(odd) { border-right: 1px solid #ddd; }
    .content-home__signals article:nth-child(even) { padding-left: 28px; }
    .content-home__signals article > p:first-child { margin: 0 0 8px; color: #777; font: 12px/1.4 ui-sans-serif, system-ui, sans-serif; text-transform: uppercase; letter-spacing: .06em; }
    .content-home__signals h3, .content-home__areas h3 { margin: 0 0 12px; font: 650 20px/1.3 ui-sans-serif, system-ui, sans-serif; }
    .content-home__signals article div { margin-top: 9px; color: #444; font: 14px/1.65 ui-sans-serif, system-ui, sans-serif; }
    .content-home__bench-links { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 16px 0 0; font-size: 13px; }
    .content-home__areas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
    .content-home__areas article { padding-top: 18px; border-top: 2px solid #222; }
    .content-home__areas article > div { color: #777; font: 13px/1.5 ui-sans-serif, system-ui, sans-serif; }
    .content-home__areas article > div span { color: #111; font-weight: 700; }
    .content-home__areas p { color: #444; font: 14px/1.65 ui-sans-serif, system-ui, sans-serif; }
    .content-home__methods > p:not(.content-home__label) { max-width: 900px; color: #444; font: 16px/1.7 ui-sans-serif, system-ui, sans-serif; }
    .content-home__method-links { display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 20px; font: 600 14px/1.5 ui-sans-serif, system-ui, sans-serif; }
    @media (max-width: 760px) {
      .shell { width: min(100% - 28px, 1120px); }
      .content-home__intro { padding-top: 48px; }
      .content-home__section-head { display: block; }
      .content-home__section-head > a { display: inline-block; margin-top: 14px; }
      .content-home__signals, .content-home__areas { grid-template-columns: 1fr; }
      .content-home__signals article, .content-home__signals article:nth-child(even) { padding: 22px 0; border-right: 0; }
    }
  </style>
</BaseLayout>
