---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import SiteFooter from "../../components/SiteFooter.astro";

import { AREAS, copyFor, LOCALES } from "../../lib/i18n.mjs";
import { loadChineseSummaries } from "../../lib/readme-localization.mjs";
import { loadRegistry, getArtifactKinds } from "../../lib/registry.mjs";
import { loadResearchModel, localize } from "../../lib/research-model.mjs";
import { loadAllResultSets, summarizeTrack } from "../../lib/results.mjs";
import { absoluteUrl, localePath, sitePath } from "../../lib/site.mjs";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props { lang: "zh" | "en"; }

const { lang } = Astro.props;
const copy = copyFor(lang);
const items = [...loadRegistry()];
const byId = new Map(items.map((item) => [item.id, item]));
const summaries = loadChineseSummaries();
const research = loadResearchModel();
const resultSets = loadAllResultSets();
const latestVerified = items.map((item) => item.last_verified).sort().at(-1);
const timelineItems = [...items].sort((a, b) => b.released.localeCompare(a.released) || a.name.localeCompare(b.name)).slice(0, 15);
const resultHighlights: any[] = [];
for (const resultSet of resultSets.values()) {
  const item = byId.get(resultSet.benchmark_id);
  const track = resultSet.tracks.find((entry: any) => entry.primary) || resultSet.tracks[0];
  if (item) resultHighlights.push({ item, resultSet, track, summary: summarizeTrack(track) });
}
resultHighlights.sort((left: any, right: any) => right.item.released.localeCompare(left.item.released));
resultHighlights.splice(8);
const suiteHighlights = AREAS.flatMap((area) => research.recipes.filter((recipe: any) => recipe.area === area).slice(0, 2));
const canonicalPath = localePath(lang);
const alternatePath = localePath(lang === "zh" ? "en" : "zh");
const title = lang === "zh" ? "Agent Benchmark Radar｜筛选、时间轴、评测组合与当前成绩" : "Agent Benchmark Radar | Browse, Timeline, Suites, and Current Scores";
const description = lang === "zh"
  ? "用于筛选 Agent 基准、查看发布时间轴、打开基准详情、组合常见评测，并追踪当前最好成绩与剩余参考空间。"
  : "Browse agent benchmarks, inspect the release timeline, open benchmark details, reuse common evaluation suites, and track current best scores with source-backed headroom.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: absoluteUrl(canonicalPath),
  inLanguage: copy.langTag,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: items.length,
    itemListElement: timelineItems.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: absoluteUrl(localePath(lang, `benchmarks/${item.id}/`)),
      name: item.name,
    })),
  },
};
const summaryFor = (item: any) => lang === "zh" ? summaries.get(item.id) || item.summary : item.summary;
const trackingLabels: Record<string, string> = {
  live: lang === "zh" ? "动态追踪" : "Live",
  "paper-snapshot": lang === "zh" ? "论文快照" : "Paper snapshot",
  "verified-snapshot": lang === "zh" ? "核验快照" : "Verified snapshot",
};
const trackingLabel = (status: string) => trackingLabels[status] || status;
---

<BaseLayout
  {lang}
  {title}
  {description}
  {canonicalPath}
  zhPath={lang === "zh" ? canonicalPath : alternatePath}
  enPath={lang === "en" ? canonicalPath : alternatePath}
  {jsonLd}
  bodyClass="radar-page home-v2 home-research-tool"
>
  <Header {lang} alternatePath={alternatePath} />
  <main id="main-content">
    <section class="tool-home-hero shell">
      <p class="eyebrow">Agent Benchmark Radar</p>
      <h1>{lang === "zh" ? "一个用来选基准、看进展的研究工具" : "A research tool for choosing benchmarks and tracking progress"}</h1>
      <p>{description}</p>
      <div class="tool-home-actions">
        <a class="button button--primary" href={sitePath(localePath(lang, "benchmarks/"))}>{lang === "zh" ? "筛选基准" : "Browse benchmarks"} ↗</a>
        <a class="button button--secondary" href="#timeline">{lang === "zh" ? "看时间轴" : "View timeline"}</a>
        <a class="button button--secondary" href={sitePath(localePath(lang, "evaluate/"))}>{lang === "zh" ? "常见评测组合" : "Common suites"}</a>
        <a class="button button--secondary" href="#results">{lang === "zh" ? "看当前成绩" : "Current scores"}</a>
      </div>
      <dl class="tool-home-stats">
        <div><dt>{lang === "zh" ? "基准总数" : "Benchmarks"}</dt><dd>{items.length}</dd></div>
        <div><dt>{lang === "zh" ? "已有结构化成绩" : "Tracked results"}</dt><dd>{resultSets.size}</dd></div>
        <div><dt>{lang === "zh" ? "最近核验" : "Last verified"}</dt><dd>{latestVerified}</dd></div>
      </dl>
    </section>

    <section class="home-section shell" id="timeline" aria-labelledby="timeline-title">
      <div class="tool-section-heading">
        <div><p class="eyebrow">{lang === "zh" ? "时间轴" : "Timeline"}</p><h2 id="timeline-title">{lang === "zh" ? "最新基准时间轴" : "Latest benchmark timeline"}</h2></div>
        <p>{lang === "zh" ? "按基准的规范发布时间排序。点开任意条目直接进入详情页。" : "Ordered by canonical benchmark release time. Open any item for its detail page."}</p>
      </div>
      <div class="benchmark-timeline">
        {timelineItems.map((item: any) => (
          <article class="benchmark-timeline__item" data-area={item.area}>
            <time datetime={item.released}>{item.released}</time>
            <div>
              <span>{copy.areas[item.area].label} · {copy.roles[item.evolution_role]}</span>
              <h3><a href={sitePath(localePath(lang, `benchmarks/${item.id}/`))}>{item.name}</a></h3>
              <p>{summaryFor(item)}</p>
            </div>
            <aside>
              <span>{getArtifactKinds(item).map((kind) => copy.artifacts[kind]).join(" · ")}</span>
              {resultSets.has(item.id) && <strong>{trackingLabel(resultSets.get(item.id).tracking_status)}</strong>}
            </aside>
          </article>
        ))}
      </div>
      <p class="tool-section-more"><a href={sitePath(localePath(lang, "benchmarks/?sort=newest"))}>{lang === "zh" ? "查看全部基准" : "View all benchmarks"} ↗</a></p>
    </section>

    <section class="home-section home-results-section" id="results" aria-labelledby="results-title">
      <div class="shell">
        <div class="tool-section-heading">
          <div><p class="eyebrow">{lang === "zh" ? "当前成绩" : "Current scores"}</p><h2 id="results-title">{lang === "zh" ? "常见与最新基准目前刷到多少" : "How far common and recent benchmarks have been pushed"}</h2></div>
          <p>{lang === "zh" ? "只展示已绑定任务、数据切分、评测协议、指标与一手来源的结果；只有存在可靠参考目标时才显示剩余空间。" : "Only source-backed tracks with explicit task, split, protocol, and metric are shown. Headroom appears only when a reliable reference target exists."}</p>
        </div>
        <div class="tool-result-table" role="list">
          {resultHighlights.map(({ item, resultSet, track, summary }: any) => (
            <a class="tool-result-row" role="listitem" href={sitePath(localePath(lang, `benchmarks/${item.id}/#results`))}>
              <div><strong>{item.name}</strong><span>{copy.areas[item.area].label} · {item.released}</span></div>
              <div><span>{localize(track.label, lang)}</span><small>{summary.best.method}</small></div>
              <div class="tool-result-row__score"><strong>{summary.best.score}<small>{track.metric.unit}</small></strong></div>
              <div class="tool-result-row__headroom">{summary.headroom !== undefined ? <><strong>{summary.headroom}%</strong><span>{lang === "zh" ? "剩余参考空间" : "headroom"}</span></> : <span>{lang === "zh" ? "无统一上限" : "no shared ceiling"}</span>}</div>
              <span class="tool-result-row__status">{trackingLabel(resultSet.tracking_status)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section shell" id="suites" aria-labelledby="suite-title">
      <div class="tool-section-heading">
        <div><p class="eyebrow">{lang === "zh" ? "评测组合" : "Evaluation suites"}</p><h2 id="suite-title">{lang === "zh" ? "常见评测组合" : "Common evaluation suites"}</h2></div>
        <p>{lang === "zh" ? "围绕研究主张组合核心评测与补充评测，而不是简单堆叠互不相关的基准。" : "Combine Core + Complement benchmarks around a research claim rather than stacking unrelated scores."}</p>
      </div>
      <div class="tool-suite-grid">
        {suiteHighlights.map((recipe: any) => (
          <a href={sitePath(localePath(lang, `evaluate/?recipe=${recipe.id}`))} data-area={recipe.area}>
            <span>{copy.areas[recipe.area].label}</span>
            <h3>{localize(recipe.claim, lang)}</h3>
            <p>{lang === "zh" ? `${recipe.core.length} 个核心 · ${recipe.complement.length} 个补充` : `${recipe.core.length} Core · ${recipe.complement.length} Complement`}</p>
            <strong>{lang === "zh" ? "打开组合" : "Open suite"} ↗</strong>
          </a>
        ))}
      </div>
      <p class="tool-section-more"><a href={sitePath(localePath(lang, "evaluate/"))}>{lang === "zh" ? "查看全部 15 组评测方案" : "View all 15 suite recipes"} ↗</a></p>
    </section>

    <section class="area-links shell area-links--compact" aria-labelledby="area-title">
      <div class="tool-section-heading"><div><p class="eyebrow">{lang === "zh" ? "研究方向" : "Research areas"}</p><h2 id="area-title">{lang === "zh" ? "按研究方向进入" : "Browse by research area"}</h2></div></div>
      <div class="area-links__grid">
        {AREAS.map((area) => (
          <a data-area={area} href={sitePath(localePath(lang, `areas/${area}/`))}><span>{copy.areas[area].label}</span><small>{items.filter((item) => item.area === area).length} {lang === "zh" ? "个基准" : "benchmarks"}</small><b>↗</b></a>
        ))}
      </div>
    </section>
  </main>
  <SiteFooter {lang} />
</BaseLayout>
