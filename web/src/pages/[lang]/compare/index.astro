---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

import { copyFor, LOCALES } from "../../../lib/i18n.mjs";
import { loadChineseSummaries } from "../../../lib/readme-localization.mjs";
import { loadRegistry } from "../../../lib/registry.mjs";
import { loadResearchModel, localize } from "../../../lib/research-model.mjs";
import { loadAllResultSets, summarizeTrack } from "../../../lib/results.mjs";
import { absoluteUrl, localePath } from "../../../lib/site.mjs";

export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang }, props: { lang } })); }
interface Props { lang: "zh" | "en"; }
const { lang } = Astro.props;
const copy = copyFor(lang);
const items = [...loadRegistry()];
const summaries = loadChineseSummaries();
const research = loadResearchModel();
const resultSets = loadAllResultSets();
const comparisonData = items.map((item) => {
  const editorial = research.benchmarkEditorial.get(item.id);
  const resultSet = resultSets.get(item.id);
  const track = resultSet && (resultSet.tracks.find((entry: any) => entry.primary) || resultSet.tracks[0]);
  const result = track ? summarizeTrack(track) : undefined;
  return {
    id: item.id, name: item.name, area: copy.areas[item.area].label, released: item.released,
    summary: lang === "zh" ? summaries.get(item.id) || item.summary : item.summary,
    scale: item.scale, capabilities: item.capabilities, environment: item.environment, protocol: item.protocol,
    scoreSupports: localize(editorial.score_supports, lang), suiteRole: localize(editorial.suite_role, lang),
    comparison_controls: editorial.comparison_controls.map((control: any) => localize(control, lang)),
    result: result && {
      score: result.best.score,
      method: result.best.method,
      metric: localize(track.label, lang),
      metricFamily: track.metric.family,
      direction: track.metric.direction,
      unit: track.metric.unit,
      protocolVersion: track.protocol_version,
      task: localize(track.task, lang),
      split: localize(track.split, lang),
      verifiedAt: resultSet.verified_at,
      trackingStatus: resultSet.tracking_status,
    },
  };
});
const serializedData = JSON.stringify(comparisonData).replaceAll("<", "\\u003c");
const canonicalPath = localePath(lang, "compare/");
const alternatePath = localePath(lang === "zh" ? "en" : "zh", "compare/");
const title = lang === "zh" ? "Agent Benchmark 对比工作台｜先对齐协议，再看成绩" : "Agent Benchmark Comparison Workspace | Align Protocols Before Scores";
const description = lang === "zh" ? "并排比较最多三个 Benchmark 的测量对象、环境、协议与规模。只有结果轨道属于同一 protocol cell 时，分数才标记为可直接比较。" : "Compare up to three benchmarks across measurement target, environment, protocol, and scale. Scores are marked directly comparable only when their result tracks share the same protocol cell.";
const jsonLd = { "@context": "https://schema.org", "@type": "WebApplication", name: title, description, url: absoluteUrl(canonicalPath), applicationCategory: "ResearchApplication", inLanguage: copy.langTag };
---

<BaseLayout {lang} {title} {description} {canonicalPath} zhPath={lang === "zh" ? canonicalPath : alternatePath} enPath={lang === "en" ? canonicalPath : alternatePath} {jsonLd} bodyClass="radar-page compare-page">
  <Header {lang} alternatePath={alternatePath} />
  <main id="main-content" data-compare-workspace data-lang={lang}>
    <section class="tool-hero shell"><p class="eyebrow">{lang === "zh" ? "比较工作台 · 解释层" : "Comparison workspace · interpretive layer"}</p><h1>{lang === "zh" ? "先判断是否可比，再并排看分数" : "Decide comparability before reading scores side by side"}</h1><p>{description}</p></section>
    <section class="compare-workspace shell">
      <div class="compare-controls" data-compare-controls></div>
      <div class="compare-table" data-compare-table aria-live="polite"></div>
    </section>
    <script is:inline type="application/json" id="compare-data" set:html={serializedData}></script>
  </main>
  <SiteFooter {lang} />
</BaseLayout>

<script>
  import { initCompareWorkspaces } from "../../../scripts/compare.mjs";
  initCompareWorkspaces();
</script>
