---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import PageHero from '../../../components/PageHero.astro';
import { LOCALES, copyFor } from '../../../lib/i18n.mjs';
import { loadRegistry } from '../../../lib/registry.mjs';
import { loadResearchModel, localize } from '../../../lib/research-model.mjs';
import { publicationWindow } from '../../../lib/publication.mjs';
import { inReleaseWindow, isPublishedRecord, releaseDate, releaseLabel, isoDay } from '../../../lib/release-time.mjs';
import { localePath, sitePath } from '../../../lib/site.mjs';
export function getStaticPaths(){return LOCALES.map(lang=>({params:{lang},props:{lang}}));}
interface Props{lang:'zh'|'en';}
const {lang}=Astro.props,zh=lang==='zh',copy=copyFor(lang),period=publicationWindow(),research=loadResearchModel();
const items=loadRegistry(),byId=new Map(items.map(item=>[item.id,item]));
const recentItems=items.filter(item=>isPublishedRecord(item)&&inReleaseWindow(item,period.frontier));
const canonicalPath=localePath(lang,'frontier/'),alternatePath=localePath(zh?'en':'zh','frontier/');
const title=zh?'前沿解读 | Agent Benchmark Radar':'Frontier interpretation | Agent Benchmark Radar';
const description=zh?'先查看近期公开记录，再阅读有明确证据锚点的研究观察。':'Start with recent dated records, then explore research observations anchored in specific benchmarks.';
---
<BaseLayout {lang} {title} {description} {canonicalPath} zhPath={zh?canonicalPath:alternatePath} enPath={zh?alternatePath:canonicalPath} bodyClass="radar-page frontier-page">
  <Header {lang} {alternatePath}/><main id="main-content"><PageHero title={zh?'近期记录与前沿解读':'Recent records and frontier interpretation'} {description}/>
    <section class="shell page-section"><div class="section-heading"><h2>{zh?'最近 30 天的公开记录':'Dated records in the last 30 days'}</h2><a href={sitePath(localePath(lang,'timeline/'))}>{zh?'完整时间轴':'Full timeline'} →</a></div><p class="content-note">{isoDay(period.frontier.start)} — {period.asOf} · {recentItems.length} {zh?'项；月份精度按区间重叠纳入，历史日期保留事件类型待复核标记。':'records. Month precision uses interval overlap; unclassified historical dates retain that label.'}</p>
      <div class="table-scroll frontier-records" role="region" tabindex="0" aria-label={zh?'近 30 天记录，可横向滚动':'Recent records, horizontally scrollable'}><table><caption>{zh?'近 30 天公开记录':'30-day public-record window'}</caption><thead><tr><th>{zh?'日期':'Date'}</th><th>Benchmark</th><th>{zh?'日期类型 / 来源':'Date type / source'}</th></tr></thead><tbody>{recentItems.map(item=>{const date=releaseDate(item);return <tr><td>{date.date}</td><td><a href={sitePath(localePath(lang,`benchmarks/${item.id}/`))}>{item.name}</a></td><td><a href={date.source}>{releaseLabel(date,lang)} ↗</a></td></tr>})}</tbody></table></div>
    </section>
    <section class="shell page-section"><h2>{zh?'哪些测量边界可能正在改变':'Which measurement boundaries may be changing'}</h2><p class="content-note">{zh?'编辑观察，不代表已确立趋势。下面列出每个判断所依赖的具体基准，供进一步复核。':'Editorial observations, not established trends. Each hypothesis names the benchmarks supporting further scrutiny.'}</p><div class="frontier-shift-list">{research.frontierShifts.map((shift:any)=><article><p class="eyebrow">{copy.areas[shift.area].label} · {shift.period}</p><h3>{localize(shift.title,lang)}</h3><p>{localize(shift.delta,lang)}</p><p><strong>{zh?'研究含义：':'Implication: '}</strong>{localize(shift.consequence,lang)}</p><div class="action-links">{shift.benchmarks.map((id:string)=><a href={sitePath(localePath(lang,`benchmarks/${id}/`))}>{byId.get(id)?.name} →</a>)}</div></article>)}</div></section>
  </main><SiteFooter {lang}/>
</BaseLayout>
