---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

import { copyFor, LOCALES } from "../../../lib/i18n.mjs";
import { loadChineseSummaries } from "../../../lib/readme-localization.mjs";
import { loadRegistry } from "../../../lib/registry.mjs";
import { loadResearchModel, localize } from "../../../lib/research-model.mjs";
import { absoluteUrl, localePath, sitePath } from "../../../lib/site.mjs";

export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang }, props: { lang } })); }
interface Props { lang: "zh" | "en"; }
const { lang } = Astro.props;
const copy = copyFor(lang);
const research = loadResearchModel();
const items = [...loadRegistry()];
const summaries = loadChineseSummaries();
const canonicalPath = localePath(lang, "evaluate/");
const alternatePath = localePath(lang === "zh" ? "en" : "zh", "evaluate/");
const title = lang === "zh" ? "Agent 评测组合生成器｜从研究 Claim 选择 Benchmarks" : "Agent Evaluation Suite Builder | Select Benchmarks from a Research Claim";
const description = lang === "zh" ? "从研究主张出发，组合核心与补充 Benchmark，明确分数支持范围和下一步验证。" : "Start from a research claim, combine core and complementary benchmarks, and define claim support and next validation.";
const jsonLd = { "@context": "https://schema.org", "@type": "WebApplication", name: title, description, url: absoluteUrl(canonicalPath), applicationCategory: "ResearchApplication", inLanguage: copy.langTag };
const itemSummary = (item: any) => lang === "zh" ? summaries.get(item.id) || item.summary : item.summary;
---

<BaseLayout {lang} {title} {description} {canonicalPath} zhPath={lang === "zh" ? canonicalPath : alternatePath} enPath={lang === "en" ? canonicalPath : alternatePath} {jsonLd} bodyClass="radar-page evaluate-page">
  <Header {lang} alternatePath={alternatePath} />
  <main id="main-content" data-suite-builder data-lang={lang}>
    <section class="tool-hero shell">
      <p class="eyebrow">Evaluation suite builder</p>
      <h1>{lang === "zh" ? "先写 Claim，再配 Benchmark" : "Write the claim, then build the suite"}</h1>
      <p>{description}</p>
    </section>

    <section class="suite-workspace shell">
      <div class="suite-catalog">
        <header><span>01</span><div><h2>{lang === "zh" ? "选择研究主张" : "Choose a research claim"}</h2><p>{lang === "zh" ? "15 组可复用评测方案，覆盖三个 Agent 研究领域。" : "15 reusable suite recipes across three agent research areas."}</p></div></header>
        <div class="recipe-list">
          {research.recipes.map((recipe: any) => (
            <button type="button" class="recipe-option" data-recipe={recipe.id} data-core={JSON.stringify(recipe.core)} data-complement={JSON.stringify(recipe.complement)} data-boundary={localize(recipe.claim_boundary, lang)} data-next={localize(recipe.next_validation, lang)}>
              <span>{copy.areas[recipe.area].label}</span><strong>{localize(recipe.claim, lang)}</strong><small>{recipe.core.length} core · {recipe.complement.length} complement</small>
            </button>
          ))}
        </div>

        <details class="suite-library">
          <summary><span>02 · {lang === "zh" ? "按需调整 Benchmark" : "Adjust individual benchmarks"}</span><b>＋</b></summary>
          <label class="suite-search"><span>{lang === "zh" ? "搜索 Registry" : "Search registry"}</span><input type="search" data-suite-search placeholder={lang === "zh" ? "名称、能力或环境" : "Name, capability, or environment"} /></label>
          <div class="suite-library__items">
            {items.map((item) => <label data-suite-item data-search={`${item.name} ${item.area} ${item.capabilities.join(" ")} ${item.environment.join(" ")}`.toLowerCase()}><input type="checkbox" name="benchmark" value={item.id} /><span><strong>{item.name}</strong><small>{copy.areas[item.area].label} · {item.released}</small><em>{itemSummary(item)}</em></span></label>)}
          </div>
        </details>
      </div>

      <aside class="suite-output">
        <p class="eyebrow">Your evaluation suite</p>
        <h2 data-suite-title>{lang === "zh" ? "选择一个研究主张" : "Choose a research claim"}</h2>
        <p data-suite-boundary>{lang === "zh" ? "这里会显示该组合支持的判断范围。" : "The supported claim boundary will appear here."}</p>
        <div class="suite-output__count"><strong data-suite-count>0</strong><span>Benchmarks</span></div>
        <ol data-suite-selection></ol>
        <div class="suite-output__next"><span>{lang === "zh" ? "下一步验证" : "Next validation"}</span><p data-suite-next>—</p></div>
        <div class="suite-output__actions"><button class="button button--primary" type="button" data-copy-suite>{lang === "zh" ? "复制 Markdown" : "Copy Markdown"}</button><a class="button button--secondary" data-compare-suite href={sitePath(localePath(lang, "compare/"))}>{lang === "zh" ? "并排比较" : "Compare"} ↗</a></div>
        <p class="suite-output__feedback" data-suite-feedback aria-live="polite"></p>
      </aside>
    </section>
  </main>
  <SiteFooter {lang} />
</BaseLayout>

<script>
  import { initSuiteBuilders } from "../../../scripts/evaluate.mjs";
  initSuiteBuilders();
</script>
