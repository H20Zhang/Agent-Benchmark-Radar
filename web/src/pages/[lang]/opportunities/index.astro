---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

import { AREAS, copyFor, LOCALES } from "../../../lib/i18n.mjs";
import { loadResearchModel, localize } from "../../../lib/research-model.mjs";
import { absoluteUrl, localePath, sitePath } from "../../../lib/site.mjs";

export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang }, props: { lang } })); }
interface Props { lang: "zh" | "en"; }
const { lang } = Astro.props;
const copy = copyFor(lang);
const research = loadResearchModel();
const canonicalPath = localePath(lang, "opportunities/");
const alternatePath = localePath(lang === "zh" ? "en" : "zh", "opportunities/");
const title = lang === "zh" ? "Agent Benchmark 评测机会地图｜发现下一步研究坐标" : "Agent Benchmark Opportunity Map | Discover the Next Evaluation Coordinate";
const description = lang === "zh" ? "从研究重要性、当前证据、下一坐标和可执行评测设计发现值得补充的 Agent Benchmark。" : "Discover agent benchmark opportunities through research importance, current evidence, next coordinates, and executable evaluation designs.";
const jsonLd = { "@context": "https://schema.org", "@type": "CollectionPage", name: title, description, url: absoluteUrl(canonicalPath), inLanguage: copy.langTag, numberOfItems: research.opportunities.length };
---

<BaseLayout {lang} {title} {description} {canonicalPath} zhPath={lang === "zh" ? canonicalPath : alternatePath} enPath={lang === "en" ? canonicalPath : alternatePath} {jsonLd} bodyClass="radar-page opportunities-page">
  <Header {lang} alternatePath={alternatePath} />
  <main id="main-content">
    <section class="tool-hero shell"><p class="eyebrow">Opportunity map</p><h1>{lang === "zh" ? "找到下一步值得建立的评测坐标" : "Find the next evaluation coordinate worth building"}</h1><p>{description}</p></section>
    <section class="opportunity-map shell" data-opportunity-map>
      <div class="opportunity-map__controls"><button class="is-active" type="button" data-opportunity-area="all">{lang === "zh" ? "全部机会" : "All opportunities"}</button>{AREAS.map((area) => <button type="button" data-opportunity-area={area}>{copy.areas[area].label}</button>)}</div>
      <div class="opportunity-map__axis"><span>{lang === "zh" ? "已有证据" : "Current evidence"}</span><i></i><span>{lang === "zh" ? "下一坐标" : "Next coordinate"}</span><i></i><span>{lang === "zh" ? "可执行设计" : "Executable design"}</span></div>
      <div class="opportunity-map__grid">
        {research.opportunities.map((opportunity: any, index: number) => (
          <article data-opportunity-card data-area={opportunity.area}>
            <div class="opportunity-map__meta"><span>{String(index + 1).padStart(2, "0")} · {copy.areas[opportunity.area].label}</span><small>{opportunity.confidence === "high" ? (lang === "zh" ? "高置信信号" : "High-confidence signal") : (lang === "zh" ? "演进信号" : "Emerging signal")}</small></div>
            <h2><a href={sitePath(localePath(lang, `opportunities/${opportunity.id}/`))}>{localize(opportunity.title, lang)}</a></h2>
            <div class="opportunity-map__evidence"><span>{lang === "zh" ? "为什么重要" : "Why it matters"}</span><p>{localize(opportunity.why_it_matters, lang)}</p></div>
            <div class="opportunity-map__next"><span>{lang === "zh" ? "下一坐标" : "Next coordinate"}</span><p>{localize(opportunity.next_coordinate, lang)}</p></div>
            <div class="opportunity-map__design"><span>{lang === "zh" ? "评测起点" : "Evaluation start"}</span><p>{localize(opportunity.candidate_evaluation, lang)}</p></div>
            <a class="opportunity-map__action" href={sitePath(localePath(lang, `opportunities/${opportunity.id}/`))}>{lang === "zh" ? "查看证据与评测协议" : "Inspect evidence and protocol"} ↗</a>
          </article>
        ))}
      </div>
    </section>
  </main>
  <SiteFooter {lang} />
</BaseLayout>

<script>
  for (const root of document.querySelectorAll("[data-opportunity-map]")) {
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-opportunity-area]");
    const cards = root.querySelectorAll<HTMLElement>("[data-opportunity-card]");
    for (const button of buttons) button.addEventListener("click", () => {
      const area = button.dataset.opportunityArea ?? "all";
      for (const item of buttons) item.classList.toggle("is-active", item === button);
      for (const card of cards) card.toggleAttribute("hidden", area !== "all" && card.getAttribute("data-area") !== area);
      const query = new URLSearchParams();
      if (area !== "all") query.set("area", area);
      history.replaceState({}, "", `${location.pathname}${query.size ? `?${query}` : ""}`);
    });
    const requested = new URLSearchParams(location.search).get("area");
    const initial = [...buttons].find((button) => button.getAttribute("data-opportunity-area") === requested);
    if (initial) initial.click();
  }
</script>
