---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

import { AREAS, copyFor, LOCALES } from "../../../lib/i18n.mjs";
import { loadResearchModel, localize } from "../../../lib/research-model.mjs";
import { absoluteUrl, localePath, sitePath } from "../../../lib/site.mjs";

export function getStaticPaths() { return LOCALES.map((lang) => ({ params: { lang }, props: { lang } })); }
interface Props { lang: "zh" | "en"; }
const { lang } = Astro.props;
const copy = copyFor(lang);
const research = loadResearchModel();
const canonicalPath = localePath(lang, "opportunities/");
const alternatePath = localePath(lang === "zh" ? "en" : "zh", "opportunities/");
const title = lang === "zh" ? "Agent Benchmark 研究机会｜基于现有证据的待验证假设" : "Agent Benchmark Opportunities | Hypotheses to Validate from Current Evidence";
const description = lang === "zh" ? "研究机会是基于现有 Benchmark 证据边界提出的解释与候选评测设计，不属于与发布时间轴同等级的事实。" : "Research opportunities are interpretations and candidate evaluation designs inferred from current benchmark evidence, not facts at the same confidence level as release chronology.";
const jsonLd = { "@context": "https://schema.org", "@type": "CollectionPage", name: title, description, url: absoluteUrl(canonicalPath), inLanguage: copy.langTag, numberOfItems: research.opportunities.length };
---

<BaseLayout {lang} {title} {description} {canonicalPath} zhPath={lang === "zh" ? canonicalPath : alternatePath} enPath={lang === "en" ? canonicalPath : alternatePath} {jsonLd} bodyClass="radar-page opportunities-page">
  <Header {lang} alternatePath={alternatePath} />
  <main id="main-content">
    <section class="tool-hero shell"><p class="eyebrow">{lang === "zh" ? "研究机会 · 解释层" : "Research opportunities · interpretive layer"}</p><h1>{lang === "zh" ? "值得验证的研究假设" : "Research hypotheses to test"}</h1><p>{description}</p><p><a href={sitePath(localePath(lang, "timeline/"))}>{lang === "zh" ? "查看 Benchmark 公开记录 →" : "Start from the canonical benchmark timeline →"}</a></p></section>
    <section class="opportunity-map shell" data-opportunity-map>
      <div class="opportunity-map__controls"><button class="is-active" type="button" data-opportunity-area="all">{lang === "zh" ? "全部假设" : "All hypotheses"}</button>{AREAS.map((area) => <button type="button" data-opportunity-area={area}>{copy.areas[area].label}</button>)}</div>
      <div class="opportunity-map__axis"><span>{lang === "zh" ? "事实证据" : "Evidence"}</span><i></i><span>{lang === "zh" ? "推断坐标" : "Inferred coordinate"}</span><i></i><span>{lang === "zh" ? "候选实验" : "Candidate experiment"}</span></div>
      <div class="opportunity-map__grid">
        {research.opportunities.map((opportunity: any, index: number) => (
          <article data-opportunity-card data-area={opportunity.area}>
            <div class="opportunity-map__meta"><span>{String(index + 1).padStart(2, "0")} · {copy.areas[opportunity.area].label}</span><small>{opportunity.confidence === "high" ? (lang === "zh" ? "编辑假设 · 待验证" : "Editorial hypothesis · unvalidated") : (lang === "zh" ? "探索性推断" : "Emerging inference")}</small></div>
            <h2><a href={sitePath(localePath(lang, `opportunities/${opportunity.id}/`))}>{localize(opportunity.title, lang)}</a></h2>
            <div class="opportunity-map__evidence"><span>{lang === "zh" ? "为什么可能重要" : "Why it may matter"}</span><p>{localize(opportunity.why_it_matters, lang)}</p></div>
            <div class="opportunity-map__next"><span>{lang === "zh" ? "推断的下一坐标" : "Inferred next coordinate"}</span><p>{localize(opportunity.next_coordinate, lang)}</p></div>
            <div class="opportunity-map__design"><span>{lang === "zh" ? "候选评测起点" : "Candidate evaluation start"}</span><p>{localize(opportunity.candidate_evaluation, lang)}</p></div>
            <a class="opportunity-map__action" href={sitePath(localePath(lang, `opportunities/${opportunity.id}/`))}>{lang === "zh" ? "查看证据、置信度与推断边界" : "Inspect evidence, confidence, and inference boundary"} ↗</a>
          </article>
        ))}
      </div>
    </section>
  </main>
  <SiteFooter {lang} />
</BaseLayout>

<script>
  import { writePageState } from "../../../scripts/page-state.mjs";
  for (const root of document.querySelectorAll("[data-opportunity-map]")) {
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-opportunity-area]");
    const cards = root.querySelectorAll<HTMLElement>("[data-opportunity-card]");
    for (const button of buttons) button.addEventListener("click", () => {
      const area = button.dataset.opportunityArea ?? "all";
      for (const item of buttons) { item.classList.toggle("is-active", item === button); item.setAttribute("aria-pressed", String(item === button)); }
      for (const card of cards) card.toggleAttribute("hidden", area !== "all" && card.getAttribute("data-area") !== area);
      const query = new URLSearchParams();
      if (area !== "all") query.set("area", area);
      writePageState(query);
    });
    const requested = new URLSearchParams(location.search).get("area");
    const initial = [...buttons].find((button) => button.getAttribute("data-opportunity-area") === requested);
    if (initial) initial.click();
  }
</script>
