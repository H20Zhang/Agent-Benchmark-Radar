---
import { localizeChineseProse } from "../lib/chinese-localization.mjs";
import { localize } from "../lib/research-model.mjs";
import { summarizeTrack } from "../lib/results.mjs";

interface Props {
  lang: "zh" | "en";
  resultSet: any;
}

const { lang, resultSet } = Astro.props;
const labels = lang === "zh" ? {
  eyebrow: "结果证据",
  title: "各自 protocol cell 内报告了什么",
  verified: "结果最后核验",
  task: "任务",
  split: "数据切分",
  protocol: "评测协议",
  method: "方法 / 系统",
  score: "分数",
  date: "结果日期",
  source: "来源",
  best: "该轨道报告最佳",
  headroom: "到来源支持参考目标的归一化距离",
  direction: "优化方向",
  higher: "越高越好",
  lower: "越低越好",
} : {
  eyebrow: "Result evidence",
  title: "What is reported inside each protocol cell",
  verified: "Result last verified",
  task: "Task",
  split: "Split",
  protocol: "Protocol",
  method: "Method / system",
  score: "Score",
  date: "Result date",
  source: "Source",
  best: "Reported best on this track",
  headroom: "Normalized distance to a source-backed reference target",
  direction: "Direction",
  higher: "Higher is better",
  lower: "Lower is better",
};
const zhTrackingLabels: Record<string, string> = {
  live: "动态追踪",
  "paper-snapshot": "论文快照",
  "verified-snapshot": "核验快照",
};
const enTrackingLabels: Record<string, string> = {
  live: "Live tracking",
  "paper-snapshot": "Paper snapshot",
  "verified-snapshot": "Verified snapshot",
};
const statusLabel = lang === "zh"
  ? (zhTrackingLabels[resultSet.tracking_status] || "来源快照")
  : (enTrackingLabels[resultSet.tracking_status] || "Source snapshot");
---

<section id="results" class="results-panel" aria-labelledby="results-heading">
  <div class="results-panel__heading">
    <div><p class="eyebrow">{labels.eyebrow}</p><h2 id="results-heading">{labels.title}</h2><p>{lang === "zh" ? "不同轨道、任务、数据切分或协议版本之间的数值不自动可比。" : "Values from different tracks, tasks, splits, or protocol versions are not automatically comparable."}</p></div>
    <div class="results-panel__status"><span>{statusLabel}</span><time datetime={resultSet.verified_at}>{labels.verified} · {resultSet.verified_at}</time></div>
  </div>

  <div class="result-tracks">
    {resultSet.tracks.map((track: any, trackIndex: number) => {
      const summary = summarizeTrack(track);
      const metric = track.metric;
      const sorted = [...track.entries].sort(metric.direction === "lower" ? (a, b) => a.score - b.score : (a, b) => b.score - a.score);
      const range = metric.range || [Math.min(...track.entries.map((entry: any) => entry.score)), Math.max(...track.entries.map((entry: any) => entry.score))];
      const span = Math.max(0.0001, range[1] - range[0]);
      return (
        <article class="result-track">
          <header>
            <div><span>{String(trackIndex + 1).padStart(2, "0")}</span><h3>{localize(track.label, lang)}</h3></div>
            <div class="result-track__best"><small>{labels.best}</small><strong>{summary.best.score}<em>{metric.unit}</em></strong><span>{summary.best.method}</span></div>
          </header>

          <dl class="result-contract">
            <div><dt>{labels.task}</dt><dd>{localizeChineseProse(localize(track.task, lang), lang)}</dd></div>
            <div><dt>{labels.split}</dt><dd>{localizeChineseProse(localize(track.split, lang), lang)}</dd></div>
            <div><dt>{labels.protocol}</dt><dd>{track.protocol_version}</dd></div>
            <div><dt>{labels.direction}</dt><dd>{metric.direction === "higher" ? labels.higher : labels.lower}</dd></div>
          </dl>

          <div class="score-bars" aria-hidden="true">
            {sorted.map((entry: any, index: number) => (
              <div class="score-bar" style={`--score-width:${Math.max(3, (entry.score - range[0]) / span * 100)}%`}>
                <span>{String(index + 1).padStart(2, "0")}</span><i></i><b>{entry.score}{metric.unit}</b>
              </div>
            ))}
          </div>

          <div class="result-table-wrap">
            <table class="result-table">
              <thead><tr><th>{labels.method}</th><th>{labels.score}</th><th>{labels.date}</th><th>{labels.source}</th></tr></thead>
              <tbody>
                {sorted.map((entry: any, index: number) => (
                  <tr class={index === 0 ? "is-best" : undefined}>
                    <td><strong>{entry.method}</strong>{entry.model && entry.model !== entry.method && <small>{entry.model}</small>}</td>
                    <td>{entry.score} {metric.unit}</td>
                    <td><time datetime={entry.date}>{entry.date}</time></td>
                    <td><a href={entry.source} rel="noreferrer">{lang === "zh" ? "核验来源" : "Verify source"} ↗</a></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {summary.headroom !== undefined && <p class="result-track__headroom"><span>{labels.headroom}</span><strong>{summary.headroom}%</strong></p>}
        </article>
      );
    })}
  </div>
</section>
