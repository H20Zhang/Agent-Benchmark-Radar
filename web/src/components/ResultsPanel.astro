---
import { presentResult } from '../lib/results.mjs';
import { localize } from '../lib/research-model.mjs';
interface Props { lang:'zh'|'en'; resultSet:any; }
const {lang,resultSet}=Astro.props;
const zh=lang==='zh';
---
<section id="results" class="results-panel page-section" aria-labelledby="results-heading">
  <div class="section-heading"><div><p class="eyebrow">{zh?'结果证据':'Result evidence'}</p><h2 id="results-heading">{zh?'已收录的结果记录':'Recorded results'}</h2></div><p>{zh?'结果核验':'Result verified'} <time datetime={resultSet.verified_at}>{resultSet.verified_at}</time></p></div>
  <p class="content-note">{zh?'这些记录是来源快照，不保证覆盖全部方法。任务、数据切分、模型、预算或评判器不一致时，不据此归因组件优劣。':'These source snapshots may not cover every method. Different tasks, splits, models, budgets, or evaluators do not establish component-level superiority.'}</p>
  {resultSet.tracks.map((track:any)=>{
    const view=presentResult(resultSet,lang,track);
    if(!view) throw new Error(`Empty result track: ${track.track_id}`);
    const sorted=[...track.entries].sort(track.metric.direction==='lower'?(a,b)=>a.score-b.score:(a,b)=>b.score-a.score);
    return <article class="result-track">
      <header><h3>{localize(track.label,lang)}</h3><p><strong>{view.label}: {view.score}{view.unit}</strong> · {view.status}</p><p class="content-note">{view.scope}</p></header>
      <dl class="result-contract"><div><dt>{zh?'任务':'Task'}</dt><dd lang={zh&&typeof track.task==='string'?'en':undefined}>{localize(track.task,lang)}</dd></div><div><dt>{zh?'数据切分':'Split'}</dt><dd lang={zh&&typeof track.split==='string'?'en':undefined}>{localize(track.split,lang)}</dd></div><div><dt>{zh?'协议':'Protocol'}</dt><dd>{track.protocol_version}</dd></div><div><dt>{zh?'指标':'Metric'}</dt><dd>{track.metric.label} · {track.metric.direction==='higher'?(zh?'越高越好':'Higher is better'):(zh?'越低越好':'Lower is better')}</dd></div></dl>
      <div class="table-scroll" role="region" tabindex="0" aria-label={localize(track.label,lang)}><table class="result-table"><caption>{localize(track.label,lang)}</caption><thead><tr><th scope="col">{zh?'方法 / 模型':'Method / model'}</th><th scope="col">{zh?'条件 / 预算（来源原文）':'Conditions / budget'}</th><th scope="col">{zh?'分数':'Score'}</th><th scope="col">{zh?'结果日期':'Reported'}</th><th scope="col">{zh?'来源':'Source'}</th></tr></thead><tbody>{sorted.map(entry=><tr><td><strong>{entry.method}</strong>{entry.model&&entry.model!==entry.method&&<small>{entry.model}</small>}</td><td class="result-conditions">{!entry.model&&<small>{zh?'模型未单独报告':'Model not separately reported'}</small>}{entry.context&&<p lang={zh?'en':undefined}>{entry.context}</p>}{entry.budget?<p lang={zh?'en':undefined}>{entry.budget}</p>:<small>{zh?'预算未在本记录中报告':'Budget not reported in this record'}</small>}</td><td>{entry.score}{track.metric.unit}</td><td><time datetime={entry.date}>{entry.date}</time></td><td><a href={entry.source}>{zh?'原始来源 ↗':'Primary source ↗'}</a></td></tr>)}</tbody></table></div>
      {track.metric.reference_target&&<details class="reference-target"><summary>{zh?'参考目标定义（不是研究机会估计）':'Reference target definition (not research headroom)'}</summary><p>{track.metric.reference_target.value}{track.metric.unit} · {track.metric.reference_target.type} · <a href={track.metric.reference_target.source}>{zh?'目标来源':'Target source'}</a></p><p>{zh?'理论满分与可实现的提升不是同一个概念。本数值不参与基准筛选或研究机会排序。':'A theoretical ceiling is not an attainable improvement estimate. This value is not used to filter benchmarks or rank research opportunities.'}</p></details>}
    </article>;
  })}
</section>
