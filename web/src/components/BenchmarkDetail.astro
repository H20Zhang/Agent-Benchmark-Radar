---
import ResultsPanel from './ResultsPanel.astro';
import { copyFor } from '../lib/i18n.mjs';
import { presentResult } from '../lib/results.mjs';
import { releaseDate, releaseLabel } from '../lib/release-time.mjs';
import { localizeTechnicalToken } from '../lib/chinese-localization.mjs';
import { displayToken, localePath, sitePath, REPOSITORY_URL } from '../lib/site.mjs';
import { localize } from '../lib/research-model.mjs';
interface Props {lang:'zh'|'en';item:any;summary:string;research:any;resultSet?:any;deepRead?:any;genealogy?:any;recipes:any[];benchmarkById:Map<string,any>;}
const {lang,item,summary,research,resultSet,deepRead,genealogy,recipes,benchmarkById}=Astro.props;
const zh=lang==='zh',copy=copyFor(lang),release=releaseDate(item),view=presentResult(resultSet,lang);
const sources=Object.entries(item.artifacts).filter(([,value])=>value);
const token=(value:string)=>localizeTechnicalToken(value,lang,displayToken);
const example=localize(research.example,lang);
const timeline=sitePath(localePath(lang,`timeline/?area=${item.area}&window=all&month=${release.date.slice(0,7)}`));
---
<article class="benchmark-detail">
  <nav class="breadcrumb" aria-label={zh?'面包屑':'Breadcrumb'}><a href={sitePath(localePath(lang,'benchmarks/'))}>{zh?'基准目录':'Library'}</a><span>/</span><a href={sitePath(localePath(lang,`areas/${item.area}/`))}>{copy.areas[item.area].label}</a><span>/</span><span aria-current="page">{item.name}</span></nav>
  <header class="detail-hero">
    <div class="record-meta"><span class="area-label" data-area={item.area}>{copy.areas[item.area].label}</span><a href={timeline}><time datetime={release.date}>{release.date}</time></a><span>{releaseLabel(release,lang)}</span><a href={release.source}>{zh?'日期来源 ↗':'Date source ↗'}</a></div>
    <h1>{item.name}</h1><p class="detail-summary">{summary}</p>
    <div class="action-links">{sources.map(([kind,url])=><a href={url as string}>{copy.artifacts[kind]||displayToken(kind)} ↗</a>)}</div>
    <div class="benchmark-at-a-glance">
      <p>{zh?'条目信息核验':'Registry verified'} <time datetime={item.last_verified}>{item.last_verified}</time>{item.citations?.status==='ok'&&<> · S2 {item.citations.count} <small>({item.citations.updated_at})</small></>}</p>
      {view&&<div data-result-summary><strong>{view.label}：{view.score}{view.unit}</strong><span>{view.model} {view.model&&view.model!==view.method?'·':''} {view.model===view.method?'':view.method} · {view.trackLabel}</span><small>{view.status} · {zh?'结果核验':'Result verified'} {view.verifiedAt} · {view.scope}</small><a href={view.source}>{zh?'结果原始来源 ↗':'Original result source ↗'}</a></div>}
    </div>
  </header>
  <nav class="section-nav" aria-label={zh?'本文章节':'Article sections'}><a href="#setup">{zh?'测量设计':'Design'}</a><a href="#interpretation">{zh?'研究解读':'Interpretation'}</a><a href="#results">{zh?'结果记录':'Results'}</a><a href="#related">{zh?'相关评测':'Related'}</a></nav>
  <section id="setup" class="page-section">
    <h2>{zh?'测量设计':'Measurement design'}</h2>
    <div class="brief-grid"><article><h3>{zh?'什么时候值得用':'When to use it'}</h3><p>{research.evidenceBrief}</p></article>{example&&<article><h3>{zh?'一个任务示例':'A concrete task'}</h3><p>{example}</p></article>}</div>
    <dl class="benchmark-setup-list"><div><dt>{zh?'规模（来源原文）':'Scale'}</dt><dd lang="en">{research.evaluation_contract.scale}</dd></div><div><dt>{zh?'能力':'Capabilities'}</dt><dd>{item.capabilities.map(token).join(' · ')}</dd></div><div><dt>{zh?'环境':'Environment'}</dt><dd>{item.environment.map(token).join(' · ')}</dd></div><div><dt>{zh?'评测协议':'Protocol'}</dt><dd>{item.protocol.map(token).join(' · ')}</dd></div></dl>
    <details class="record-provenance"><summary>{zh?'查看日期事件与来源':'Date events and provenance'}</summary><dl>{['first_public_at','publication_at','data_release_at'].map(field=><div><dt>{releaseLabel({field},lang)}</dt><dd>{item[field]?<><time datetime={item[field]}>{item[field]}</time> · <a href={item.release_date_evidence[field].source}>{zh?'一手来源':'Primary source'}</a> · {item.release_date_evidence[field].precision}</>:(zh?'尚无可核验记录':'No verified event recorded')}</dd></div>)}</dl></details>
  </section>
  <section id="interpretation" class="page-section deep-read" aria-labelledby="interpretation-heading"><div class="section-heading"><h2 id="interpretation-heading">{zh?'研究解读':'Research interpretation'}</h2><span class="evidence-label">{zh?'编辑解读，不等同于发布事实':'Editorial interpretation'}</span></div>
    {deepRead ? <><details class="article-toc"><summary>{zh?'解读目录':'Contents'}</summary><nav aria-label={zh?'解读目录':'Interpretation contents'}>{deepRead.headings.map((heading:{id:string,text:string})=><a href={`#${heading.id}`}>{heading.text}</a>)}</nav></details><div class="deep-read__content" set:html={deepRead.html}></div></>:<p>{research.evidenceBrief}</p>}
  </section>
  {resultSet?<ResultsPanel {lang} {resultSet}/>:<section id="results" class="page-section compact-result-gap"><h2>{zh?'结果记录':'Result records'}</h2><p>{zh?'尚未收录结构化结果；可先阅读论文或官方项目中的实验。':'Structured results have not been recorded yet. Consult the paper or official project for experiments.'} <a href={item.artifacts.paper||item.artifacts.code}>{zh?'打开来源 ↗':'Open source ↗'}</a></p></section>}
  <section id="related" class="page-section"><h2>{zh?'相关评测与组合':'Related benchmarks and suites'}</h2><div class="related-recipes">{recipes.map(recipe=><a href={sitePath(localePath(lang,`evaluate/?recipe=${recipe.id}`))}><strong>{localize(recipe.claim,lang)}</strong><span>{recipe.core.includes(item.id)?(zh?'核心评测':'Core'):(zh?'补充评测':'Complement')} · {recipe.core.length+recipe.complement.length} {zh?'个基准':'benchmarks'} →</span></a>)}</div>{genealogy&&<details class="editorial-section"><summary>{zh?'查看编辑谱系':'View editorial genealogy'}</summary><div class="genealogy-rail">{genealogy.stages.map((stage:any)=><article><h3>{localize(stage.label,lang)}</h3>{stage.benchmarks.map((id:string)=><a href={sitePath(localePath(lang,`benchmarks/${id}/`))}>{benchmarkById.get(id)?.name}</a>)}</article>)}</div></details>}</section>
  <footer class="detail-footer"><a href={timeline}>{zh?'回到所在月份':'Back to its month'} →</a><a href={`${REPOSITORY_URL}/blob/main/benchmarks/${item.id}${zh?'':'.en'}.md`}>{zh?'编辑解读源文':'Authored source'} ↗</a></footer>
</article>
