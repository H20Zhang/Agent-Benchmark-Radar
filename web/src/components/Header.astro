---
import { localePath, sitePath } from '../lib/site.mjs';
interface Props { lang: 'zh' | 'en'; alternatePath?: string; }
const { lang, alternatePath = localePath(lang === 'zh' ? 'en' : 'zh') } = Astro.props;
const navItems = [
  ['timeline/', '时间轴', 'Timeline'], ['benchmarks/', '筛选基准', 'Library'],
  ['evaluate/', '评测组合', 'Suites'], ['frontier/', '前沿解读', 'Frontier'],
  ['opportunities/', '研究机会', 'Opportunities'], ['methodology/', '方法', 'Methodology'],
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="site-header__inner shell">
    <a class="site-brand" href={sitePath(localePath(lang))}>Agent Benchmark <strong>Radar</strong></a>
    <nav class="site-nav" aria-label={lang === 'zh' ? '主导航' : 'Primary navigation'}>
      {navItems.map(([suffix, zh, en]) => <a href={sitePath(localePath(lang, suffix))} aria-current={path.includes(`/${suffix}`) ? 'page' : undefined}>{lang === 'zh' ? zh : en}</a>)}
      <a class="site-nav__language" data-language-path={sitePath(alternatePath)} href={sitePath(alternatePath)} hreflang={lang === 'zh' ? 'en' : 'zh-CN'}>{lang === 'zh' ? 'English' : '中文'}</a>
    </nav>
  </div>
</header>
<script>
  import { syncLanguageLinks } from '../scripts/page-state.mjs';
  syncLanguageLinks();
  window.addEventListener('popstate', syncLanguageLinks);
  window.addEventListener('hashchange', syncLanguageLinks);
</script>
