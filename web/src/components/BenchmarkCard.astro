---
import { loadChineseSummaries } from '../lib/readme-localization.mjs';
import { copyFor } from '../lib/i18n.mjs';
import { getArtifactKinds } from '../lib/registry.mjs';
import { getStableFacetValues } from '../lib/research-model.mjs';
import { presentResult } from '../lib/results.mjs';
import { releaseDate } from '../lib/release-time.mjs';
import { localizeTechnicalToken } from '../lib/chinese-localization.mjs';
import { displayToken, localePath, sitePath } from '../lib/site.mjs';
interface Props { lang:'zh'|'en'; item:any; summary:string; resultSet?:any; }
const {lang,item,summary,resultSet}=Astro.props;
const copy=copyFor(lang), artifacts=getArtifactKinds(item), result=presentResult(resultSet,lang), release=releaseDate(item);
const detail=sitePath(localePath(lang,`benchmarks/${item.id}/`));
const search=[item.name,loadChineseSummaries().get(item.id),item.summary,item.measurement_strength,item.scale,...item.capabilities,...item.environment,...item.protocol].join(' ');
---
<article class="benchmark-card" data-benchmark-id={item.id} data-area={item.area} data-role={item.evolution_role} data-released={release.date} data-artifacts={JSON.stringify(artifacts)} data-capabilities={JSON.stringify(item.capabilities)} data-environments={JSON.stringify(item.environment)} data-protocols={JSON.stringify(item.protocol)} data-stable-facets={JSON.stringify(getStableFacetValues(item))} data-result-status={resultSet?'tracked':'untracked'} data-result-tracking-status={resultSet?.tracking_status||'untracked'} data-metric-families={JSON.stringify([...new Set(resultSet?.tracks.map((t:any)=>t.metric.family)||[])])} data-citations={item.citations?.status==='ok'?item.citations.count:-1} data-search={search}>
  <div class="benchmark-card__topline"><span class="area-label" data-area={item.area}>{copy.areas[item.area].label}</span><time datetime={release.date}>{release.date}</time></div>
  <div class="benchmark-card__main"><h3><a href={detail}>{item.name}</a></h3><p class="benchmark-card__summary">{summary}</p><ul class="token-list">{item.capabilities.slice(0,3).map((token:string)=><li>{localizeTechnicalToken(token,lang,displayToken)}</li>)}</ul></div>
  <div class="benchmark-card__result">{result ? <><span>{result.label}</span><strong>{result.score}<small>{result.unit}</small></strong><p>{result.model}{result.model&&result.model!==result.method?' · ':''}{result.model===result.method?'':result.method}</p><small>{result.trackLabel}</small><small>{result.status} · {result.verifiedAt}</small><a href={result.source}>{lang==='zh'?'结果来源 ↗':'Result source ↗'}</a></>:<p class="content-note">{lang==='zh'?'结果尚未结构化':'Results not yet structured'}</p>}</div>
  <div class="benchmark-card__footer">{artifacts.map(kind=><a href={item.artifacts[kind]}>{copy.artifacts[kind]} ↗</a>)}<a href={detail}>{lang==='zh'?'详情 →':'Detail →'}</a></div>
</article>
